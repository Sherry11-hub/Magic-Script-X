# ─────────────────────────────────────────────────────────────────────────────
# Generative AI Event & Script Copilot — Environment Variables Template
# Copy this file to `.env` and fill in your values.
# NEVER commit the actual `.env` file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── OpenAI Settings (REQUIRED) ────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here

# ── LLM Model Selection ───────────────────────────────────────────────────────
# Options: gpt-3.5-turbo, gpt-4, gpt-4-turbo, gpt-4o
LLM_MODEL=gpt-3.5-turbo

# ── LLM Behaviour ─────────────────────────────────────────────────────────────
# Temperature: 0.0 (deterministic) to 1.0 (creative). Recommend 0.3 for RAG.
LLM_TEMPERATURE=0.3
# Max tokens for LLM response generation
MAX_TOKENS=1500

# ── Embedding Provider ────────────────────────────────────────────────────────
# Options: "huggingface" (free, local) or "openai" (requires API key, higher quality)
EMBEDDING_PROVIDER=huggingface

# HuggingFace model name (only used when EMBEDDING_PROVIDER=huggingface)
# Alternatives: "BAAI/bge-small-en-v1.5", "multi-qa-MiniLM-L6-cos-v1"
HF_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── ChromaDB Vector Store ─────────────────────────────────────────────────────
# Local directory where ChromaDB will persist data between runs
CHROMA_PERSIST_DIR=./chroma_db
# Logical name for the document collection inside ChromaDB
CHROMA_COLLECTION_NAME=event_documents

# ── RAG Chunking Strategy ─────────────────────────────────────────────────────
# Target character size per chunk. 800 works well for dense event schedules.
CHUNK_SIZE=800
# Overlap prevents context loss at chunk boundaries. ~20% of chunk size is ideal.
CHUNK_OVERLAP=150

# ── Retrieval Settings ────────────────────────────────────────────────────────
# Number of document chunks to retrieve per query (K in top-K retrieval)
RETRIEVAL_K=5
